{
  "schema": "tropical_program_2",
  "name": "Combinators",
  "ports": {
    "inputs": [{ "name": "xs", "type": { "kind": "array", "element": "float", "shape": [4] }, "default": [1, 2.5, -3, 0.0625] }],
    "outputs": ["out"]
  },
  "body": {
    "op": "block",
    "decls": [
      { "op": "regDecl", "name": "buf", "init": { "zeros": 4 } }
    ],
    "assigns": [
      {
        "op": "outputAssign",
        "name": "out",
        "expr": {
          "op": "let",
          "bind": {
            "zeta": {
              "op": "fold",
              "over": { "op": "input", "name": "xs" },
              "init": 0,
              "acc_var": "acc",
              "elem_var": "e",
              "body": { "op": "add", "args": [{ "op": "binding", "name": "acc" }, { "op": "binding", "name": "e" }] }
            },
            "alpha": {
              "op": "scan",
              "over": {
                "op": "generate",
                "count": 4,
                "var": "i",
                "body": { "op": "mul", "args": [{ "op": "binding", "name": "i" }, 2] }
              },
              "init": 1,
              "acc_var": "a",
              "elem_var": "v",
              "body": { "op": "mul", "args": [{ "op": "binding", "name": "a" }, { "op": "binding", "name": "v" }] }
            }
          },
          "in": {
            "op": "index",
            "args": [
              {
                "op": "zipWith",
                "a": {
                  "op": "iterate",
                  "count": 4,
                  "init": { "op": "binding", "name": "zeta" },
                  "var": "it",
                  "body": { "op": "mul", "args": [{ "op": "binding", "name": "it" }, 0.5] }
                },
                "b": {
                  "op": "map2",
                  "over": { "op": "reg", "name": "buf" },
                  "elem_var": "m",
                  "body": { "op": "add", "args": [{ "op": "binding", "name": "m" }, 1] }
                },
                "x_var": "p",
                "y_var": "q",
                "body": { "op": "add", "args": [{ "op": "binding", "name": "p" }, { "op": "binding", "name": "q" }] }
              },
              {
                "op": "chain",
                "count": 2,
                "init": 0,
                "var": "c",
                "body": { "op": "add", "args": [{ "op": "binding", "name": "c" }, 1] }
              }
            ]
          }
        }
      },
      {
        "op": "nextUpdate",
        "target": { "kind": "reg", "name": "buf" },
        "expr": { "op": "arraySet", "args": [{ "op": "reg", "name": "buf" }, 0, { "op": "index", "args": [{ "op": "input", "name": "xs" }, 1] }] }
      }
    ]
  },
  "params": [
    { "name": "rate", "value": 4, "time_const": 0.01, "type": "param" },
    { "name": "fire", "type": "trigger" },
    { "name": "plain" }
  ],
  "audio_outputs": [
    { "instance": "osc", "output": 0 },
    { "instance": "filt", "output": "lp" },
    { "expr": { "op": "mul", "args": [{ "op": "ref", "instance": "osc", "output": "out" }, 0.25] } }
  ]
}
