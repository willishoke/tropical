{
  "schema": "tropical_program_2",
  "name": "OpsAndBuiltins",
  "sample_rate": 48000,
  "ports": {
    "inputs": ["x", { "name": "y", "type": "float", "default": 0.25 }],
    "outputs": ["out", { "name": "aux", "type": "float", "default": 9 }]
  },
  "body": {
    "op": "block",
    "decls": [
      { "op": "regDecl", "name": "r", "init": -1.5, "type": "float" },
      { "op": "delayDecl", "name": "d", "update": { "op": "reg", "name": "r" }, "init": 0.001 },
      { "op": "paramDecl", "name": "gain", "value": 0.5 },
      { "op": "paramDecl", "name": "bare_param" }
    ],
    "assigns": [
      {
        "op": "outputAssign",
        "name": "out",
        "expr": {
          "op": "add",
          "args": [
            {
              "op": "mul",
              "args": [
                { "op": "input", "name": "x" },
                { "op": "neg", "args": [{ "op": "reg", "name": "r" }] }
              ]
            },
            {
              "op": "select",
              "args": [
                { "op": "and", "args": [
                  { "op": "gt", "args": [{ "op": "input", "name": "y" }, 0] },
                  { "op": "or", "args": [
                    { "op": "lte", "args": [{ "op": "param", "name": "gain" }, 1] },
                    { "op": "not", "args": [{ "op": "eq", "args": [{ "op": "trigger", "name": "bare_param" }, 0] }] }
                  ] }
                ] },
                { "op": "sqrt", "args": [{ "op": "abs", "args": [{ "op": "input", "name": "y" }] }] },
                { "op": "to_float", "args": [{ "op": "toInt", "args": [3.7] }] }
              ]
            }
          ]
        }
      },
      {
        "op": "outputAssign",
        "name": "aux",
        "expr": {
          "op": "clamp",
          "args": [
            { "op": "ldexp", "args": [{ "op": "sampleRate" }, -3] },
            { "op": "floor_div", "args": [{ "op": "sampleIndex" }, 2] },
            {
              "op": "bitXor",
              "args": [
                { "op": "lshift", "args": [1, 2] },
                { "op": "bitAnd", "args": [
                  { "op": "bitNot", "args": [5] },
                  { "op": "rshift", "args": [{ "op": "bitOr", "args": [96, 1] }, 1] }
                ] }
              ]
            }
          ]
        }
      },
      {
        "op": "nextUpdate",
        "target": { "kind": "reg", "name": "r" },
        "expr": {
          "op": "mod",
          "args": [
            { "op": "sub", "args": [
              { "op": "delayRef", "id": "d" },
              { "op": "div", "args": [
                { "op": "round", "args": [1e-3] },
                { "op": "floorDiv", "args": [
                  { "op": "ceil", "args": [{ "op": "floatExponent", "args": [0.1] }] },
                  { "op": "floor", "args": [
                    { "op": "neq", "args": [
                      { "op": "toBool", "args": [{ "op": "paramExpr", "name": "gain" }] },
                      { "op": "to_bool", "args": [{ "op": "toFloat", "args": [{ "op": "gte", "args": [{ "op": "lt", "args": [1, 2] }, 0] }] }] }
                    ] }
                  ] }
                ] }
              ] }
            ] },
            1
          ]
        }
      }
    ]
  }
}
