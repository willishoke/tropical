{
  "schema": "tropical_program_2",
  "name": "IdentityWire",
  "ports": {
    "inputs": [{ "name": "x", "default": 0 }],
    "outputs": ["out", "mix"]
  },
  "body": {
    "op": "block",
    "decls": [
      {
        "op": "programDecl",
        "name": "Wire",
        "program": {
          "op": "program",
          "name": "Wire",
          "ports": {
            "inputs": ["a", "b"],
            "outputs": ["p", "q"]
          },
          "body": {
            "op": "block",
            "decls": [],
            "assigns": [
              { "op": "outputAssign", "name": "p", "expr": { "op": "input", "name": "a" } },
              { "op": "outputAssign", "name": "q", "expr": { "op": "input", "name": "b" } }
            ]
          }
        }
      },
      {
        "op": "programDecl",
        "name": "Gain",
        "program": {
          "op": "program",
          "name": "Gain",
          "ports": {
            "inputs": [{ "name": "g", "default": 0 }],
            "outputs": ["y"]
          },
          "body": {
            "op": "block",
            "decls": [],
            "assigns": [
              { "op": "outputAssign", "name": "y", "expr": { "op": "mul", "args": [{ "op": "input", "name": "g" }, 0.5] } }
            ]
          }
        }
      },
      {
        "op": "instanceDecl",
        "name": "w1",
        "program": "Wire",
        "inputs": {
          "a": { "op": "input", "name": "x" },
          "b": 0.25
        }
      },
      {
        "op": "instanceDecl",
        "name": "amp",
        "program": "Gain",
        "inputs": {
          "g": { "op": "nestedOut", "ref": "w1", "output": "p" }
        }
      },
      {
        "op": "instanceDecl",
        "name": "w2",
        "program": "Wire",
        "inputs": {
          "a": { "op": "nestedOut", "ref": "amp", "output": "y" },
          "b": { "op": "nestedOut", "ref": "w1", "output": "q" }
        }
      }
    ],
    "assigns": [
      { "op": "outputAssign", "name": "out", "expr": { "op": "nestedOut", "ref": "w2", "output": "p" } },
      {
        "op": "outputAssign",
        "name": "mix",
        "expr": {
          "op": "add",
          "args": [
            { "op": "nestedOut", "ref": "w2", "output": "q" },
            { "op": "nestedOut", "ref": "w1", "output": "p" }
          ]
        }
      }
    ]
  }
}
