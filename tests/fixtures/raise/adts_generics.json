{
  "schema": "tropical_program_2",
  "name": "AdtsGenerics",
  "breaks_cycles": true,
  "type_params": {
    "N": { "type": "int", "default": 8 },
    "M": { "type": "int" }
  },
  "ports": {
    "inputs": [
      { "name": "vec", "type": { "kind": "array", "element": "float", "shape": [2, { "op": "typeParam", "name": "N" }] } },
      "trig"
    ],
    "outputs": [{ "name": "out", "type": "myfloat" }],
    "type_defs": [
      { "kind": "struct", "name": "Pair", "fields": [{ "name": "lhs", "scalar_type": "float" }, { "name": "rhs", "scalar_type": "int" }] },
      {
        "kind": "sum",
        "name": "Env",
        "variants": [
          { "name": "Idle", "payload": [] },
          { "name": "Active", "payload": [{ "name": "level", "scalar_type": "float" }, { "name": "armed", "scalar_type": "bool" }] }
        ]
      },
      { "kind": "alias", "name": "myfloat", "base": "float" }
    ]
  },
  "body": {
    "op": "block",
    "decls": [
      { "op": "regDecl", "name": "ring", "init": { "zeros": { "typeParam": "N" } } },
      {
        "op": "delayDecl",
        "name": "state",
        "type": "Env",
        "init": { "op": "tag", "type": "Env", "variant": "Idle" },
        "update": {
          "op": "match",
          "type": "Env",
          "scrutinee": { "op": "reg", "name": "state" },
          "arms": {
            "Active": {
              "bind": ["level", "armed"],
              "body": { "op": "tag", "type": "Env", "variant": "Active", "payload": { "level": { "op": "mul", "args": [{ "op": "binding", "name": "level" }, 0.999] }, "armed": { "op": "binding", "name": "armed" } } }
            },
            "Idle": {
              "body": {
                "op": "select",
                "args": [
                  { "op": "gt", "args": [{ "op": "input", "name": "trig" }, 0.5] },
                  { "op": "tag", "type": "Env", "variant": "Active", "payload": { "level": 1, "armed": true } },
                  { "op": "tag", "type": "Env", "variant": "Idle", "payload": {} }
                ]
              }
            }
          }
        }
      },
      {
        "op": "instanceDecl",
        "name": "seq",
        "program": "Sequencer",
        "type_args": { "N": 4 },
        "inputs": {
          "values": [110, 220, 330, 440],
          "clock": { "op": "input", "name": "trig" }
        }
      },
      {
        "op": "programDecl",
        "name": "Inner",
        "program": {
          "op": "program",
          "name": "Inner",
          "ports": { "inputs": [{ "name": "lvl", "type": "unipolar", "default": 2 }], "outputs": [{ "name": "y", "type": "signal" }] },
          "body": {
            "op": "block",
            "decls": [],
            "assigns": [
              { "op": "outputAssign", "name": "y", "expr": { "op": "mul", "args": [{ "op": "input", "name": "lvl" }, 2] } }
            ]
          }
        }
      },
      {
        "op": "instanceDecl",
        "name": "inner1",
        "program": "Inner",
        "inputs": { "lvl": { "op": "match", "scrutinee": { "op": "reg", "name": "state" }, "arms": { "Idle": { "body": 0 }, "Active": { "bind": "lvl", "body": { "op": "binding", "name": "lvl" } } } } }
      }
    ],
    "assigns": [
      {
        "op": "outputAssign",
        "name": "out",
        "expr": {
          "op": "add",
          "args": [
            { "op": "nestedOut", "ref": "inner1", "output": "y" },
            { "op": "nestedOut", "ref": "seq", "output": 0 }
          ]
        }
      }
    ]
  }
}
