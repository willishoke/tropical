      "outputs": { "out": { "instance": "vca1", "output": "out" } } } },
  { "method": "debug_render", "params": { "frames": 4 } },
  { "method": "wire",
    "params": { "set": [
      { "instance": "osc2", "input": "freq", "expr": 165 } ] } },
