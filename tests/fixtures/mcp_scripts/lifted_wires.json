[
  { "method": "define_program", "params": { "def": {
      "schema": "tropical_program_2",
      "name": "SumPair",
      "ports": {
        "inputs": [
          { "name": "v",
            "type": { "kind": "array", "element": "float", "shape": [2] } } ],
        "outputs": ["out"] },
      "body": { "op": "block", "decls": [],
        "assigns": [
          { "op": "outputAssign", "name": "out",
            "expr": { "op": "add", "args": [
              { "op": "index", "args": [{ "op": "input", "name": "v" }, 0] },
              { "op": "index", "args": [{ "op": "input", "name": "v" }, 1] } ] } } ],
        "value": null } } } },
  { "method": "add_instance", "params": { "program": "SumPair", "instance_name": "sp" } },
  { "method": "add_instance", "params": { "program": "SinOsc", "instance_name": "osc1" } },
  { "method": "add_instance", "params": { "program": "SinOsc", "instance_name": "osc2" } },
  { "method": "add_instance", "params": { "program": "VCA", "instance_name": "vca1" } },
  { "method": "wire",
    "params": { "set": [
      { "instance": "osc1", "input": "freq",
        "expr": { "op": "index", "args": [
          [220, 330, 440, 550],
          { "op": "toInt", "args": [{ "op": "param", "name": "step" }] } ] } },
      { "instance": "osc2", "input": "freq", "expr": 275 },
      { "instance": "vca1", "input": "audio",
        "expr": { "op": "add", "args": [
          { "op": "ref", "instance": "osc1", "output": "sine" },
          { "op": "ref", "instance": "osc2", "output": "sine" } ] } },
      { "instance": "vca1", "input": "cv",
        "expr": { "op": "index", "args": [
          [0.25, 0.5, 0.75, 1.0],
          { "op": "toInt", "args": [
            { "op": "clamp", "args": [
              { "op": "add", "args": [
                { "op": "ref", "instance": "osc1", "output": "sine" },
                { "op": "ref", "instance": "osc2", "output": "sine" } ] },
              0, 3 ] } ] } ] } },
      { "instance": "sp", "input": "v", "expr": [0.125, 0.375] },
      { "instance": "dac", "input": "out",
        "expr": { "op": "ref", "instance": "vca1", "output": "out" } },
      { "instance": "dac", "input": "out",
        "expr": { "op": "ref", "instance": "sp", "output": "out" } } ] } },
  { "method": "debug_render", "params": { "frames": 4 } },
  { "method": "list_instances", "params": {} },
  { "method": "get_info", "params": { "instance_name": "__wire_2" } },
  { "method": "get_info", "params": { "instance_name": "__wire_3" } },
  { "method": "list_wiring", "params": {} },
  { "method": "save", "params": {} },
  { "method": "export_program",
