{"ports":
 {"outputs": ["lp", "bp", "hp", "notch"],
  "inputs":
  [{"name": "input", "default": 0},
   {"type": {"op": "nameRef", "name": "freq"},
    "name": "cutoff",
    "default":
    {"op": "call",
     "callee": {"op": "nameRef", "name": "select"},
     "args": [{"op": "gt", "args": [1000, 0]}, 1000, 0]}},
   {"type": {"op": "nameRef", "name": "unipolar"},
    "name": "resonance",
    "default":
    {"op": "call",
     "callee": {"op": "nameRef", "name": "clamp"},
     "args": [0.5, 0, 1]}},
   {"name": "drive", "default": 1}]},
 "op": "program",
 "name": "LadderFilter",
 "body":
 {"op": "block",
  "decls":
  [{"update":
    {"ref": {"op": "nameRef", "name": "pole4"},
     "output": {"op": "nameRef", "name": "out"},
     "op": "nestedOut"},
    "op": "delayDecl",
    "name": "prev_lp",
    "init": 0},
   {"program": {"op": "nameRef", "name": "Tanh"},
    "op": "instanceDecl",
    "name": "tanh_in",
    "inputs":
    [{"value":
      {"op": "mul",
       "args":
       [{"op": "nameRef", "name": "drive"},
        {"op": "nameRef", "name": "input"}]},
      "port": {"op": "nameRef", "name": "x"}}]},
   {"program": {"op": "nameRef", "name": "Sin"},
    "op": "instanceDecl",
    "name": "sin_g",
    "inputs":
    [{"value":
      {"op": "mul",
       "args":
       [3.141592653589793,
        {"op": "div",
         "args":
         [{"op": "call",
           "callee": {"op": "nameRef", "name": "clamp"},
           "args":
           [{"op": "nameRef", "name": "cutoff"},
            20,
            {"op": "mul",
             "args":
             [0.49,
              {"op": "call",
               "callee": {"op": "nameRef", "name": "sampleRate"},
               "args": []}]}]},
          {"op": "call",
           "callee": {"op": "nameRef", "name": "sampleRate"},
           "args": []}]}]},
      "port": {"op": "nameRef", "name": "x"}}]},
   {"program": {"op": "nameRef", "name": "OnePole"},
    "op": "instanceDecl",
    "name": "pole1",
    "inputs":
    [{"value":
      {"op": "sub",
       "args":
       [{"ref": {"op": "nameRef", "name": "tanh_in"},
         "output": {"op": "nameRef", "name": "out"},
         "op": "nestedOut"},
        {"op": "mul",
         "args":
         [{"op": "mul", "args": [4, {"op": "nameRef", "name": "resonance"}]},
          {"op": "nameRef", "name": "prev_lp"}]}]},
      "port": {"op": "nameRef", "name": "input"}},
     {"value":
      {"op": "mul",
       "args":
       [2,
        {"ref": {"op": "nameRef", "name": "sin_g"},
         "output": {"op": "nameRef", "name": "out"},
         "op": "nestedOut"}]},
      "port": {"op": "nameRef", "name": "g"}}]},
   {"program": {"op": "nameRef", "name": "OnePole"},
    "op": "instanceDecl",
    "name": "pole2",
    "inputs":
    [{"value":
      {"ref": {"op": "nameRef", "name": "pole1"},
       "output": {"op": "nameRef", "name": "out"},
       "op": "nestedOut"},
      "port": {"op": "nameRef", "name": "input"}},
     {"value":
      {"op": "mul",
       "args":
       [2,
        {"ref": {"op": "nameRef", "name": "sin_g"},
         "output": {"op": "nameRef", "name": "out"},
         "op": "nestedOut"}]},
      "port": {"op": "nameRef", "name": "g"}}]},
   {"program": {"op": "nameRef", "name": "OnePole"},
    "op": "instanceDecl",
    "name": "pole3",
    "inputs":
    [{"value":
      {"ref": {"op": "nameRef", "name": "pole2"},
       "output": {"op": "nameRef", "name": "out"},
       "op": "nestedOut"},
      "port": {"op": "nameRef", "name": "input"}},
     {"value":
      {"op": "mul",
       "args":
       [2,
        {"ref": {"op": "nameRef", "name": "sin_g"},
         "output": {"op": "nameRef", "name": "out"},
         "op": "nestedOut"}]},
      "port": {"op": "nameRef", "name": "g"}}]},
   {"program": {"op": "nameRef", "name": "OnePole"},
    "op": "instanceDecl",
    "name": "pole4",
    "inputs":
    [{"value":
      {"ref": {"op": "nameRef", "name": "pole3"},
       "output": {"op": "nameRef", "name": "out"},
       "op": "nestedOut"},
      "port": {"op": "nameRef", "name": "input"}},
     {"value":
      {"op": "mul",
       "args":
       [2,
        {"ref": {"op": "nameRef", "name": "sin_g"},
         "output": {"op": "nameRef", "name": "out"},
         "op": "nestedOut"}]},
      "port": {"op": "nameRef", "name": "g"}}]}],
  "assigns":
  [{"op": "outputAssign",
    "name": "lp",
    "expr":
    {"ref": {"op": "nameRef", "name": "pole4"},
     "output": {"op": "nameRef", "name": "out"},
     "op": "nestedOut"}},
   {"op": "outputAssign",
    "name": "bp",
    "expr":
    {"op": "sub",
     "args":
     [{"ref": {"op": "nameRef", "name": "pole2"},
       "output": {"op": "nameRef", "name": "out"},
       "op": "nestedOut"},
      {"ref": {"op": "nameRef", "name": "pole4"},
       "output": {"op": "nameRef", "name": "out"},
       "op": "nestedOut"}]}},
   {"op": "outputAssign",
    "name": "hp",
    "expr":
    {"op": "sub",
     "args":
     [{"op": "nameRef", "name": "input"},
      {"ref": {"op": "nameRef", "name": "pole4"},
       "output": {"op": "nameRef", "name": "out"},
       "op": "nestedOut"}]}},
   {"op": "outputAssign",
    "name": "notch",
    "expr":
    {"op": "add",
     "args":
     [{"op": "sub",
       "args":
       [{"op": "nameRef", "name": "input"},
        {"ref": {"op": "nameRef", "name": "pole4"},
         "output": {"op": "nameRef", "name": "out"},
         "op": "nestedOut"}]},
      {"ref": {"op": "nameRef", "name": "pole4"},
       "output": {"op": "nameRef", "name": "out"},
       "op": "nestedOut"}]}}]}}
