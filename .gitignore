# Reproducible room-audition renders. Keep generators, JSON summaries, and
# compact fitted carrier assets in Git; WAV listening outputs are local build
# evidence and are regenerated by benchmarks/demo_release/room_audition/*.py.
/benchmarks/demo_release/room_audition/out/*.wav
/benchmarks/demo_release/room_audition/reference_out/*.wav
/benchmarks/demo_release/room_audition/match_out/*.wav
/benchmarks/demo_release/room_audition/recovery_out/*.wav
/benchmarks/demo_release/room_audition/grouped_fit_out/*.wav
/benchmarks/demo_release/room_audition/reverse_position_out/*.wav
/benchmarks/demo_release/room_audition/native_rate_out/*.wav
/benchmarks/demo_release/room_audition/pizzicato_audition_out/*.wav
/benchmarks/demo_release/room_audition/match_out/modal_profiles.json
/benchmarks/demo_release/room_audition/grouped_fit_out/grouped_fit_current_radii_stereo.npz
/benchmarks/demo_release/room_audition/grouped_fit_out/grouped_fit_decay_ladder.npz
/benchmarks/demo_release/room_audition/native_rate_out/grouped_fit_current_radii_stereo.npz
/benchmarks/demo_release/room_audition/native_rate_out/grouped_fit_decay_ladder.npz
/benchmarks/demo_release/room_audition/release_out/*.wav

# Raw qualification streams and callback-sampler audio are archived as
# checksummed release evidence. Keep compact summaries and manifests in Git.
/benchmarks/demo_release/data/*.jsonl
/benchmarks/demo_release/data/*.capture.wav

