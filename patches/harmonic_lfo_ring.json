{
  "schema": "tropical_program_2",
  "name": "harmonic_lfo_ring",
  "body": {
    "op": "block",
    "decls": [
      {
        "op": "programDecl",
        "name": "PhaseSine",
        "program": {
          "op": "program",
          "name": "PhaseSine",
          "ports": { "inputs": ["freq"], "outputs": ["sine"] },
          "body": {
            "op": "block",
            "decls": [
              { "op": "regDecl", "name": "phase", "init": 0 },
              {
                "op": "instanceDecl",
                "name": "s",
                "program": "Sin",
                "inputs": {
                  "x": { "op": "mul", "args": [6.283185307179586, { "op": "reg", "name": "phase" }] }
                }
              }
            ],
            "assigns": [
              { "op": "outputAssign", "name": "sine", "expr": { "op": "nestedOut", "ref": "s", "output": "out" } },
              {
                "op": "nextUpdate",
                "target": { "kind": "reg", "name": "phase" },
                "expr": {
                  "op": "mod",
                  "args": [
                    {
                      "op": "add",
                      "args": [
                        { "op": "reg", "name": "phase" },
                        { "op": "div", "args": [{ "op": "input", "name": "freq" }, { "op": "sampleRate" }] }
                      ]
                    },
                    1
                  ]
                }
              }
            ],
            "value": null
          }
        }
      },

      { "op": "instanceDecl", "name": "osc1", "program": "SinOsc", "inputs": { "freq": 110 } },
      { "op": "instanceDecl", "name": "osc2", "program": "SinOsc", "inputs": { "freq": 330 } },
      { "op": "instanceDecl", "name": "osc3", "program": "SinOsc", "inputs": { "freq": 550 } },
      { "op": "instanceDecl", "name": "osc4", "program": "SinOsc", "inputs": { "freq": 770 } },
      { "op": "instanceDecl", "name": "osc5", "program": "SinOsc", "inputs": { "freq": 1210 } },

      {
        "op": "instanceDecl", "name": "lfo1", "program": "PhaseSine",
        "inputs": { "freq": { "op": "add", "args": [0.3, { "op": "mul", "args": [0.05, { "op": "delay", "args": [{ "op": "ref", "instance": "lfo5", "output": "sine" }], "init": 0 }] }] } }
      },
      {
        "op": "instanceDecl", "name": "lfo2", "program": "PhaseSine",
        "inputs": { "freq": { "op": "add", "args": [0.5, { "op": "mul", "args": [0.05, { "op": "delay", "args": [{ "op": "ref", "instance": "lfo1", "output": "sine" }], "init": 0 }] }] } }
      },
      {
        "op": "instanceDecl", "name": "lfo3", "program": "PhaseSine",
        "inputs": { "freq": { "op": "add", "args": [0.7, { "op": "mul", "args": [0.05, { "op": "delay", "args": [{ "op": "ref", "instance": "lfo2", "output": "sine" }], "init": 0 }] }] } }
      },
      {
        "op": "instanceDecl", "name": "lfo4", "program": "PhaseSine",
        "inputs": { "freq": { "op": "add", "args": [0.9, { "op": "mul", "args": [0.05, { "op": "delay", "args": [{ "op": "ref", "instance": "lfo3", "output": "sine" }], "init": 0 }] }] } }
      },
      {
        "op": "instanceDecl", "name": "lfo5", "program": "PhaseSine",
        "inputs": { "freq": { "op": "add", "args": [1.1, { "op": "mul", "args": [0.05, { "op": "delay", "args": [{ "op": "ref", "instance": "lfo4", "output": "sine" }], "init": 0 }] }] } }
      },

      {
        "op": "instanceDecl", "name": "vca1", "program": "VCA",
        "inputs": {
          "audio": { "op": "ref", "instance": "osc1", "output": "sine" },
          "cv": { "op": "add", "args": [0.1, { "op": "mul", "args": [0.1, { "op": "ref", "instance": "lfo1", "output": "sine" }] }] }
        }
      },
      {
        "op": "instanceDecl", "name": "vca2", "program": "VCA",
        "inputs": {
          "audio": { "op": "ref", "instance": "osc2", "output": "sine" },
          "cv": { "op": "add", "args": [0.1, { "op": "mul", "args": [0.1, { "op": "ref", "instance": "lfo2", "output": "sine" }] }] }
        }
      },
      {
        "op": "instanceDecl", "name": "vca3", "program": "VCA",
        "inputs": {
          "audio": { "op": "ref", "instance": "osc3", "output": "sine" },
          "cv": { "op": "add", "args": [0.1, { "op": "mul", "args": [0.1, { "op": "ref", "instance": "lfo3", "output": "sine" }] }] }
        }
      },
      {
        "op": "instanceDecl", "name": "vca4", "program": "VCA",
        "inputs": {
          "audio": { "op": "ref", "instance": "osc4", "output": "sine" },
          "cv": { "op": "add", "args": [0.1, { "op": "mul", "args": [0.1, { "op": "ref", "instance": "lfo4", "output": "sine" }] }] }
        }
      },
      {
        "op": "instanceDecl", "name": "vca5", "program": "VCA",
        "inputs": {
          "audio": { "op": "ref", "instance": "osc5", "output": "sine" },
          "cv": { "op": "add", "args": [0.1, { "op": "mul", "args": [0.1, { "op": "ref", "instance": "lfo5", "output": "sine" }] }] }
        }
      }
    ],
    "assigns": [
      { "op": "outputAssign", "name": "dac.out", "expr": { "op": "ref", "instance": "vca1", "output": "out" } },
      { "op": "outputAssign", "name": "dac.out", "expr": { "op": "ref", "instance": "vca2", "output": "out" } },
      { "op": "outputAssign", "name": "dac.out", "expr": { "op": "ref", "instance": "vca3", "output": "out" } },
      { "op": "outputAssign", "name": "dac.out", "expr": { "op": "ref", "instance": "vca4", "output": "out" } },
      { "op": "outputAssign", "name": "dac.out", "expr": { "op": "ref", "instance": "vca5", "output": "out" } }
    ],
    "value": null
  }
}
